# Any OpenAI-compatible endpoint. Default: Azure OpenAI's v1 API, deployments named after models.
LLM_BASE_URL=https://<your-resource>.openai.azure.com/openai/v1/
LLM_API_KEY=

# "strong" writes questions, grades answers and writes the overview; "cheap" summarizes files.
LLM_MODEL_STRONG=gpt-5-mini
LLM_MODEL_CHEAP=gpt-5-mini
# Reasoning effort (minimal | low | medium | high). Leave empty for non-reasoning models
# such as gpt-4o-mini; they then run at temperature 0.
LLM_EFFORT_STRONG=medium
LLM_EFFORT_CHEAP=minimal

EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1024

# Optional: raises GitHub's limit from 60 to 5000 API calls/hour (needed in production).
# A fine-grained token with no extra permissions is enough for public repos.
GITHUB_TOKEN=

# Local Postgres from docker-compose. In production, your Neon/Supabase URL (add ?sslmode=require).
DATABASE_URL=postgresql://viva:viva@localhost:5433/viva

# Ingestion limits
MAX_FILES=150
MAX_INFRA_FILES=15
MAX_FILE_BYTES=200000
